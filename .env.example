# Энэ файлыг .env нэрээр хуулж утгуудаа бөглөнө. .env-ийг git рүү бүү оруул.
HOST=127.0.0.1
PORT=47650

# Урт санамсаргүй тэмдэгт (жишээ нь: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=

# Эхний админ (сервер анх асахад үүснэ)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Түвшин тогтоох шалгалтад түвшин бүрээс хэдэн асуулт
PLACEMENT_PER_LEVEL=5
# Түвшний шалгалтын асуултын тоо
EXAM_SIZE=10
# Анх асахад жишээ физикийн контент оруулах (1/0)
SEED_SAMPLE=1

# Hosting дээр:
# DATA_DIR=...            # SQLite фолдер (заавал биш)
# COOKIE_SECURE=1         # https дээр cookie-г зөвхөн secure болгох

# Vercel дээр Storage → Neon холбоход автоматаар орно. Локалд хоосон бол SQLite ашиглана.
# DATABASE_URL=postgresql://...
# Цагийн бүс (анхдагч Asia/Ulaanbaatar)
# APP_TZ=Asia/Ulaanbaatar
